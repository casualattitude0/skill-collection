#!/usr/bin/env python3
"""list-skills — emit {skill-name: description} as JSON for `jev pick --kind skills`.

Fallback for when the skill-library MCP server is not connected. Uses the
same catalog the server's find_skill does: MANIFEST.md rows with status
`library` or `linked`, minus disable-model-invocation and manager-side skills.
"""
import importlib.machinery
import importlib.util
import json
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
server = os.path.join(here, "..", "..", "skill-library", "server.py")
loader = importlib.machinery.SourceFileLoader("skill_library", server)
spec = importlib.util.spec_from_loader("skill_library", loader)
mod = importlib.util.module_from_spec(spec)
loader.exec_module(mod)

json.dump(mod.catalog(), sys.stdout, indent=1, ensure_ascii=False)
print()
